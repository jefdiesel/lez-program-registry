            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "now",
          "type": "u64"
        }
      ]
    },
    {
      "name": "Update",
      "tag": 2,
      "docs": "Update by the entry's author, rooted at the author's own actor. Writes a write-once\nrelease snapshot; `revision` must be the stored revision + 1.",
      "fields": [
        {
          "name": "entry_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "revision",
          "type": "u32"
        },
        {
          "name": "revision_seed",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "version",
          "type": {
            "option": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "option": "string"
          }
        },
        {
          "name": "tags",
          "type": {
            "option": {
