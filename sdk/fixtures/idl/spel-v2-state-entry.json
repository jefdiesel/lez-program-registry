{
  "version": "2",
  "name": "lez_program_registry",
  "messages": [
    {
      "name": "RegisterDeployer",
      "tag": 0,
      "docs": "Deployer entry for program `X`, at the root actor `(X, registry)`. `X` must authorize it:\nits signature, or (via `via_pda_seed`) the owner program of a PDA header. The author\nco-signs and may equal `X`.",
      "fields": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "version",
          "type": "string"
        },
        {
          "name": "author_label",
          "type": "string"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "tags",
          "type": {
            "vec": "string"
          }
        },
        {
          "name": "idl",
          "type": {
            "defined": "ContentRef"
          }
        },
        {
          "name": "source",
          "type": {
            "defined": "SourceRef"
          }
        },
        {
          "name": "build",
          "type": {
            "defined": "BuildConfig"
          }
        },
        {
          "name": "image_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "author_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          },
          "docs": "The co-signing author's account id."
        },
        {
          "name": "revision",
          "type": "u32",
          "docs": "Must be 1."
        },
        {
          "name": "revision_seed",
          "type": {
            "array": [
              "u8",
              32
            ]
          },
          "docs": "`revision` as 32 little-endian bytes (the release PDA seed)."
        },
        {
          "name": "now",
          "type": "u64",
          "docs": "Block timestamp lower bound, ms; valid for 10 minutes."
        },
        {
          "name": "via_pda_seed",
          "type": {
            "option": {
              "array": [
                "u8",
                32
              ]
            }
          }
        }
      ]
    },
    {
      "name": "RegisterThirdParty",
      "tag": 1,
      "docs": "Third-party entry for `program`, at `pda[\"lezreg/v1/tp\", program, publisher]`. The\npublisher is the root actor and the author; one entry per (program, publisher).",
      "fields": [
        {
          "name": "program",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "version",
          "type": "string"
        },
        {
          "name": "author_label",
          "type": "string"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "tags",
          "type": {
            "vec": "string"
          }
        },
        {
          "name": "idl",
          "type": {
            "defined": "ContentRef"
          }
        },
        {
          "name": "source",
          "type": {
            "defined": "SourceRef"
          }
        },
        {
          "name": "build",
          "type": {
            "defined": "BuildConfig"
          }
        },
        {
          "name": "image_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "revision",
          "type": "u32"
        },
        {
