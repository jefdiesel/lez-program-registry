    },
    {
      "name": "DeployAndRegister",
      "tag": 5,
      "docs": "Deploys program `X` (loader `CreateHeader`, sent first) and writes its deployer entry in\none transaction.",
      "fields": [
        {
          "name": "first_segment",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "immutable",
          "type": "bool"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "version",
          "type": "string"
        },
        {
          "name": "author_label",
          "type": "string"
