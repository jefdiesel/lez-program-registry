            }
          }
        },
        {
          "name": "build",
          "type": {
            "option": {
              "defined": "BuildConfig"
            }
          }
        },
        {
          "name": "image_id",
          "type": {
            "option": {
              "array": [
                "u8",
                32
              ]
            }
          }
        },
        {
          "name": "now",
          "type": "u64"
        },
        {
          "name": "via_pda_seed",
          "type": {
            "option": {
              "array": [
                "u8",
                32
              ]
            }
          }
        }
      ]
    },
    {
      "name": "TransferAuthor",
      "tag": 3,
      "docs": "Hands the entry to the new author. Both sign.",
      "fields": [
        {
          "name": "entry_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "new_author_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "now",
          "type": "u64"
        },
        {
          "name": "via_pda_seed",
          "type": {
            "option": {
              "array": [
                "u8",
                32
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Freeze",
      "tag": 4,
      "docs": "Irreversibly freezes the entry.",
      "fields": [
        {
          "name": "entry_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
