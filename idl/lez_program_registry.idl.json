  "metadata": {
    "name": "lez_program_registry",
    "version": "0.1.0"
  },
  "x-lez04": {
    "spec": "lezreg-idl-ext/0.1",
    "lez": "v0.4.0-rc1",
    "wire": {
      "root": "bare Instruction: u8 variant index (= instruction order = discriminator) + borsh args; not the spel v0.7.0 CLI's risc0-serde words",
      "discriminator": "one byte, the borsh variant index; not lssa-lang's sha256(\"global:<name>\")[..8]",
      "effect_tag_min": 192,
      "require_signer_tag": 255,
      "append_only": "new instructions are only appended (wire-tags.lock)"
    },
    "account_id_args": {
      "rule": "<name>_id: [u8;32] supplies the id of each non-root, non-PDA account <name> (a 0.4 guest sees only its receiver)",
      "pairs": {
        "author": "author_id",
        "new_author": "new_author_id",
        "entry": "entry_id"
      }
    },
    "accounts_rule": "every account listed is an actor to declare: (account, self) unless loader_actors says otherwise; the first account is the root; pda accounts derive under self by pda_rule; signer accounts sign",
    "instructions": {
      "register_deployer": {
        "root": {
          "account": "program",
          "program": "self"
        },
        "signers": [
          "program",
          "author"
        ],
        "signers_note": "author may equal program: declare and sign once. The root's signature may be replaced by the PDA-header path",
        "pda_header": {
          "arg": "via_pda_seed",
          "rule": "None: must be the transaction's root message. Some(s): the sender's program P must satisfy for_public_pda(P, s) == root account, and the root must be authorized (P's grant)"
        },
        "evidence": "none: registry PDAs self-admit via pda_seeds; signers are always admitted",
        "time": {
          "arg": "now",
          "window_ms": 600000
        },
        "creates": "Entry at (program, self); Release; Link"
      },
      "register_third_party": {
        "root": {
          "account": "publisher",
          "program": "self"
        },
        "signers": [
          "publisher"
        ],
        "root_only": true,
        "evidence": "none: registry PDAs self-admit via pda_seeds; signers are always admitted",
        "time": {
          "arg": "now",
          "window_ms": 600000
        },
        "creates": "Entry at (entry, self) = pda[tp, program, publisher]; Release; Link"
      },
      "update": {
        "root": {
          "account": "author",
          "program": "self"
        },
        "signers": [
          "author"
        ],
        "inline_if": "author == entry (the root actor is the entry: patched in place)",
        "pda_header": {
          "arg": "via_pda_seed",
          "rule": "None: must be the transaction's root message. Some(s): the sender's program P must satisfy for_public_pda(P, s) == root account, and the root must be authorized (P's grant)"
        },
        "evidence": "none: registry PDAs self-admit via pda_seeds; signers are always admitted",
        "time": {
          "arg": "now",
          "window_ms": 600000
        },
        "revision": "must equal the stored revision + 1; revision_seed = revision as 32 little-endian bytes"
      },
      "transfer_author": {
        "root": {
          "account": "author",
          "program": "self"
        },
        "signers": [
          "author",
          "new_author"
        ],
        "signers_note": "if new_author == entry, no probe is sent: the entry's own delivery checks new_author signed",
        "inline_if": "author == entry",
        "pda_header": {
          "arg": "via_pda_seed",
          "rule": "None: must be the transaction's root message. Some(s): the sender's program P must satisfy for_public_pda(P, s) == root account, and the root must be authorized (P's grant)"
        },
        "evidence": "none: registry PDAs self-admit via pda_seeds; signers are always admitted",
        "time": {
          "arg": "now",
          "window_ms": 600000
        }
      },
      "freeze": {
        "root": {
          "account": "author",
          "program": "self"
        },
        "signers": [
          "author"
        ],
        "inline_if": "author == entry",
        "pda_header": {
          "arg": "via_pda_seed",
          "rule": "None: must be the transaction's root message. Some(s): the sender's program P must satisfy for_public_pda(P, s) == root account, and the root must be authorized (P's grant)"
        },
        "evidence": "none: registry PDAs self-admit via pda_seeds; signers are always admitted",
        "time": {
          "arg": "now",
          "window_ms": 600000
        },
        "irreversible": true
      },
      "deploy_and_register": {
        "root": {
          "account": "program",
          "program": "self"
        },
        "signers": [
          "program",
          "author"
        ],
        "signers_note": "author may equal program. Key-held headers only (no PDA path)",
        "root_only": true,
        "evidence": "none: registry PDAs self-admit via pda_seeds; signers are always admitted",
        "time": {
          "arg": "now",
          "window_ms": 600000
        },
        "loader_actors": {
          "program_header": {
            "account": "program",
            "program": "program_loader"
          }
        },
        "first_message": "program_loader CreateHeader{first_segment, immutable} to (program, program_loader); segment accounts are not declared",
        "creates": "loader header at program; Entry with born_with_deploy; Release; Link"
      }
    },
    "internal": [
      "WriteEntry",
      "PatchEntry",
      "WriteRelease",
      "Index",
      "IndexName",
      "IndexAuthor",
      "IndexProgram",
      "WriteLink",
      "WriteAuthorNode",
      "IndexAuthorTransfer"
    ],
