# lezreg.toml: what `lezreg publish` registers (LEZ Program Registry).
# Written by `lezreg init`. Edit freely; bump `version` and rerun `lezreg publish` to
# record a new release. The commit and the Cargo.lock hash are read at publish time.

[program]
name = "m8-sample"            # immutable once registered: [a-z0-9][a-z0-9._-]*, at most 32 bytes
version = "0.1.0"
label = "M8 test"           # free-text author name, shown as UNPROVEN
description = ""
tags = ["sample"]            # at most 8, [a-z0-9-]
idl = "idl/lez_program_registry.idl.json"             # the program's IDL JSON, relative to this file

[source]
repo = "https://github.com/jefdiesel/lez-program-registry"
docker_root = "."     # build context, relative to the repository root

# The canonical build (`lezreg build`, `lezreg verify`). risc0-build 3.0.5 builds in
# risczero/risc0-guest-builder:r0.1.91.1 (pinned by digest).
[build]
risc0_build = "3.0.5"
image_tag = "r0.1.91.1"
image_digest = "fafb377a44e1cfca415577c48d2f7012bda99ed36f2fae27f9a663b9fe6048f0"
host_rust = "1.91.1"
manifest_path = "methods/guest/Cargo.toml"   # the guest's Cargo.toml, relative to docker_root
binary = "lez_program_registry"
features = []

[deploy]
author = "6iArKUXxhUJqS7kCaPNhwMWt3ro71PDyBj7jwAyE2VQV"          # the proven author; keep the header key cold
immutable = false
# program = "<id>"     # set by `lezreg publish` after the first deploy

