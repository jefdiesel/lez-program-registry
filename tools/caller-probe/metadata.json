{
  "name": "registry_probe",
  "display_name": "Registry caller probe",
  "version": "0.1.0",
  "type": "core",
  "interface": "cdylib",
  "category": "developer",
  "description": "Test fixture: an app the program_registry module does not trust, calling it through the generated client, to check the caller gate",
  "main": "registry_probe_plugin",
  "dependencies": [{ "name": "program_registry", "version": ">=0.3.0" }],

  "codegen": {
    "rust": { "crate": "rust-lib", "trait": "RegistryProbeModule" }
  },

  "nix": {
    "packages": { "build": [], "runtime": [] },
    "external_libraries": [],
    "cmake": { "find_packages": [], "extra_sources": [], "extra_include_dirs": [], "extra_link_libraries": [] }
  }
}
