+}
+
+fn account_id(hex_id: &str) -> Result<AccountId> {
+    let bytes: [u8; 32] = hex::decode(hex_id)?
+        .try_into()
+        .map_err(|_| anyhow!("an account id is 32 bytes: {hex_id}"))?;
+    Ok(AccountId::new(bytes))
+}
+
+fn external_guests(specs: &[String]) -> Result<External> {
+    let mut guests = HashMap::new();
+    for spec in specs {
+        let (id, path) = spec
+            .split_once('=')
+            .ok_or_else(|| anyhow!("--elf takes <id hex>=<path>: {spec}"))?;
+        let program = Program::new(std::fs::read(path)?.into())?;
+        let name: &'static str = Box::leak(
+            PathBuf::from(path)
+                .file_stem()
+                .map_or_else(|| path.to_owned(), |s| s.to_string_lossy().into_owned())
+                .into_boxed_str(),
+        );
+        guests.insert(account_id(id)?, (name, program));
+    }
+    Ok(Rc::new(guests))
+}
+
+fn external_case(path: &PathBuf) -> Result<Case> {
+    let case: ExternalCase = serde_json::from_slice(&std::fs::read(path)?)?;
+    let fixtures = case
+        .actors
+        .iter()
+        .map(|a| {
+            Ok(Fixture::new(
+                account_id(&a.account)?,
+                a.authorized,
+                account_id(&a.program)?,
+                hex::decode(&a.state)?.into(),
+            ))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let loader_states = case
+        .loader_states
+        .iter()
+        .map(|s| Ok((account_id(&s.account)?, hex::decode(&s.state)?.into())))
+        .collect::<Result<HashMap<_, _>>>()?;
+    Ok(Case {
+        label: Box::leak(case.label.into_boxed_str()),
+        root: Actor::new(account_id(&case.root.account)?, account_id(&case.root.program)?),
+        fixtures,
+        message: hex::decode(&case.message)?,
+        loader_states,
+        expected_rows: case.expected_rows.map(|rows| {
+            rows.into_iter()
+                .filter(|r| r.program != "loader" && r.program != "native")
+                .map(|r| r.cycles)
+                .collect()
+        }),
+    })
+}
